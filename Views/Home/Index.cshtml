@model HomeViewModel

@{
    ViewData["Title"] = "Service Station";
}

<div class="text-center">
    <h1 class="display-4">Service Station</h1>

    <form method="post" action="/Home/GetToken">
        <button class="btn-primary" type="submit">Get Token</button>
    </form>

    <form method="post" action="/Home/ServeNext">
        <button class="btn-primary" type="submit">Serve Next Customer</button>
    </form>

    <h2 class="display-5">Now Serving</h2>

    @foreach (var token in Model.ServingTokens)
    {
        <p class="display-6">Token: @token.TokenNumber</p>
    }

    <h2 class="display-5">Waiting Customers</h2>

    <!-- <p class="display-6">Waiting: @Model.WaitingTokens.Count / 5</p> -->

    @foreach (var token in Model.WaitingTokens)
    {
        <p class="display-6">Token: @token.TokenNumber</p>
    }

</div>
